# Copy this file to .env for local development. Never commit the real .env file.

# Google reCAPTCHA v3 production credentials
RECAPTCHA_SITE_KEY=replace_with_site_key
RECAPTCHA_SECRET_KEY=replace_with_secret_key
RECAPTCHA_MIN_SCORE=0.7

# Comma-separated hostnames and email recipients
PRODUCTION_HOSTS=learnandplaycv.com,www.learnandplaycv.com
CONTACT_RECIPIENTS=sires_mary@yahoo.com,jonnysires@yahoo.com

# SMTP credentials
EMAIL_SENDER=no-reply@learnandplaycv.com
EMAIL_PASSWORD=replace_with_email_password
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465

# Anti-spam timing
MIN_FORM_COMPLETION_SECONDS=20

# Application server (0.0.0.0 allows the reverse proxy to reach Uvicorn)
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
