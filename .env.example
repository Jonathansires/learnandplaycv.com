# Copy this file to .env for local development. Never commit the real .env file.

# Google reCAPTCHA v3 production credentials
RECAPTCHA_SITE_KEY=replace_with_site_key
RECAPTCHA_SECRET_KEY=replace_with_secret_key
RECAPTCHA_MIN_SCORE=0.7

# Comma-separated hostnames and email recipients
PRODUCTION_HOSTS=learnandplaycv.com,www.learnandplaycv.com
CONTACT_RECIPIENTS=sires_mary@yahoo.com,jonnysires@yahoo.com

# SMTP credentials
EMAIL_SENDER=no-reply@learnandplaycv.com
EMAIL_PASSWORD=replace_with_email_password
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465

# Anti-spam timing
MIN_FORM_COMPLETION_SECONDS=20

# Application server (0.0.0.0 allows the reverse proxy to reach Uvicorn)
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

# Employee administration: set your chosen password directly below.
# Keep the password quoted, and keep the real .env private.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=''
# Optional alternative for existing setups. ADMIN_PASSWORD takes precedence.
# ADMIN_PASSWORD_HASH=''
# Keep true on HTTPS hosting; set false ONLY for local HTTP development.
ADMIN_COOKIE_SECURE=true
# Optional absolute path to a SQLite database on a persistent disk.
# EMPLOYEE_DATABASE=/path/to/persistent/data/employees.sqlite3
